# =========================================================
# NOVA — Production Environment Configuration
# Copy this to .env and fill in production values.
# Store secrets in a secrets manager (AWS Secrets Manager,
# HashiCorp Vault) and inject at deploy time.
# =========================================================

# --- Application ---
NODE_ENV=production
PORT=3001
APP_URL=https://nova.leadup.in

# --- Database (PostgreSQL with pgvector) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nova
DB_USER=postgres
POSTGRES_PASSWORD=<generated-strong-password>
DATABASE_URL=postgres://postgres:<password>@postgres:5432/nova

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<generated-strong-password>
REDIS_URL=redis://:<password>@redis:6379

# --- S3-compatible Storage (MinIO or AWS S3) ---
S3_ENDPOINT=https://s3.amazonaws.com
S3_PORT=443
S3_ACCESS_KEY=<generated-access-key>
S3_SECRET_KEY=<generated-secret-key>
S3_BUCKET=nova-assets
S3_REGION=us-east-1

# --- Authentication (CRITICAL: Use strong, random values) ---
JWT_SECRET=<64-byte-base64-random>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=<64-byte-base64-random>
JWT_ACCESS_TTL=15m
AUTH_ENCRYPTION_KEY=<32-byte-random>
API_KEY_SECRET=<64-byte-base64-random>

# --- Auth Service ---
AUTH_PORT=3003

# --- External Services ---
# OPENAI_API_KEY=<sk-...>
# ANTHROPIC_API_KEY=<sk-ant-...>
# ELEVENLABS_API_KEY=<...>
# WHISPER_API_KEY=<...>

# --- CORS (comma-separated origins) ---
CORS_ORIGIN=https://nova.leadup.in,https://admin.nova.leadup.in

# --- Monitoring ---
LOG_LEVEL=warn
SENTRY_DSN=<sentry-dsn>
# DATADOG_API_KEY=<...>
# DATADOG_APP_KEY=<...>

# --- CI/CD ---
# GITHUB_TOKEN=<...>
