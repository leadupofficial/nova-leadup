# =========================================================
# NOVA — Production Environment Configuration
# Copy this to .env and fill in production values.
# Store secrets in a secrets manager (AWS Secrets Manager,
# HashiCorp Vault) and inject at deploy time.
# =========================================================

# --- Application ---
NODE_ENV=production
PORT=3001
APP_URL=https://nova.leadup.in

