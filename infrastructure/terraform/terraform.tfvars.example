variable "aws_region" {
 type = string
 default = "us-east-1"
 description = "AWS region for all resources"
}

variable "project_name" {
 type = string
 default = "nova-leadup"
}

variable "domain_name" {
 type = string
 default = "nova.leadup.in"
}

variable "vpc_cidr" {
 type = string
 default = "10.0.0.0/16"
}

variable "instance_type" {
 type = string
 default = "t3.large"
}

variable "db_instance_class" {
 type = string
 default = "db.t3.small"
}

variable "db_allocated_storage" {
 type = number
 default = 50
}

variable "redis_node_type" {
 type = string
 default = "cache.t3.micro"
}

variable "key_pair_name" {
 type = string
 default = ""
}

variable "ssl_certificate_arn" {
 type = string
 default = ""
}

variable "allowed_ssh_cidr" {
 type = string
 default = "0.0.0.0/0"
}

variable "multi_az" {
 type = bool
 default = false
}
