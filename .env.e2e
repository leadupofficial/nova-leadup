# E2E test environment variables
# Use with: source .env.e2e

API_URL=http://localhost:3001
AUTH_URL=http://localhost:3003
ADMIN_URL=http://localhost:3004
WEB_URL=http://localhost:3000

# Database (shared with docker-compose.dev.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nova_test
REDIS_URL=redis://localhost:6379

# Service secrets (test-only, never use in production)
JWT_SECRET=e2e-jwt-secret-do-not-use-prod
REFRESH_TOKEN_SECRET=e2e-refresh-secret-do-not-use-prod
AUTH_ENCRYPTION_KEY=e2lwZW50b2tlcmtleXdlbGx0aGluZzMyYnl0ZXNmb3J0ZXNl
API_KEY_SECRET=e2e-api-key-secret-do-not-use-prod

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nova-assets
