{
 "$schema": "https://turbo.build/schema.json",
 "globalDependencies": ["**/.env.*local"],
 "pipeline": {
 "build": {
 "dependsOn": ["^build"],
 "outputs": ["dist/**", "build/**", ".next/**"],
 "cache": true
 },
 "dev": {
 "cache": false,
 "persistent": true
 },
 "lint": {
 "dependsOn": [],
 "outputs": [],
 "cache": true
 },
 "type-check": {
 "dependsOn": ["build"],
 "outputs": [],
 "cache": true
 },
 "test": {
 "dependsOn": ["build"],
 "outputs": ["coverage/**"],
 "cache": true
 },
 "test:unit": {
 "dependsOn": ["build"],
 "outputs": ["coverage/**"],
 "cache": true
 },
 "db:migrate": {
 "dependsOn": [],
 "outputs": [],
 "cache": false
 },
 "db:seed": {
 "dependsOn": [],
 "outputs": [],
 "cache": false
 },
 "clean": {
 "cache": false
 }
 },
 "globalEnv": [
 "NODE_ENV",
 "DATABASE_URL",
 "REDIS_URL",
 "S3_ENDPOINT",
 "S3_ACCESS_KEY",
 "S3_SECRET_KEY",
 "S3_BUCKET",
 "JWT_SECRET",
 "REFRESH_TOKEN_SECRET",
 "API_KEY",
 "API_KEY_SECRET",
 "AUTH_ENCRYPTION_KEY"
 ]
}
