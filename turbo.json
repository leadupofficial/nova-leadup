{
 "$schema": "https://turbo.build/schema.json",
 "globalDependencies": ["**/.env.*local"],
 "globalEnv": [
 "DATABASE_URL",
 "REDIS_URL",
 "ANTHROPIC_API_KEY",
 "ELEVENLABS_API_KEY",
 "SARVAM_API_KEY",
 "S3_ENDPOINT",
 "S3_ACCESS_KEY",
 "S3_SECRET_KEY",
 "S3_BUCKET",
 "JWT_SECRET",
 "NODE_ENV"
 ],
 "tasks": {
 "build": {
 "dependsOn": ["^build"],
 "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
 },
 "dev": {
 "cache": false,
 "persistent": true
 },
 "lint": {
 "dependsOn": ["^build"]
 },
 "typecheck": {
 "dependsOn": ["^build"]
 },
 "test": {
 "dependsOn": ["^build"],
 "outputs": ["coverage/**"]
 },
 "clean": {
 "cache": false
 }
 }
}
