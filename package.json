{
 "name": "nova-monorepo",
 "version": "0.1.0",
 "private": true,
 "description": "NOVA — Voice-first personal AI companion (Leadup Technologies)",
 "workspaces": [
 "apps/*",
 "services/*",
 "packages/*"
 ],
 "scripts": {
 "build": "turbo run build",
 "dev": "turbo run dev --parallel",
 "lint": "turbo run lint",
 "typecheck": "turbo run typecheck",
 "test": "turbo run test",
 "clean": "turbo run clean && rm -rf node_modules .turbo"
 },
 "devDependencies": {
 "@types/node": "^22.0.0",
 "@types/react": "^19.2.18",
 "@types/react-dom": "^19.0.0",
 "eslint": "^9.17.0",
 "prettier": "^3.4.0",
 "turbo": "^2.5.0",
 "typescript": "^5.7.0"
 },
 "packageManager": "pnpm@9.15.0",
 "engines": {
 "node": ">=20.0.0",
 "pnpm": ">=9.0.0"
 }
}
