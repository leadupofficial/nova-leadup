{
  "name": "nova-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA \u2014 Voice and Visual Companion platform monorepo",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "e2e:up": "bash scripts/e2e-env.sh up",
    "e2e:down": "bash scripts/e2e-env.sh down",
    "e2e:run": "bash scripts/e2e-env.sh test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,yml,yaml,md}\"",
    "security:audit": "turbo run audit",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "dev:api": "turbo run dev --filter=@nova/api",
    "dev:auth": "turbo run dev --filter=@nova/auth",
    "dev:all": "turbo run dev"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "prettier": "^3.5.3",
    "@playwright/test": "^1.52.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}