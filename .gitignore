# Stray TypeScript build output. These were sitting untracked and would have been
# swept into a commit by `git add .`:
#   packages/shared-types/src/languages.js        (tsc emitted next to the source)
#   packages/shared-types/src/languages.d.ts.map
#   packages/shared-types/packages/               (nested accidental output dir)
#   **/tsconfig.tsbuildinfo                       (incremental build cache)
*.tsbuildinfo
packages/shared-types/src/*.js
packages/shared-types/src/*.d.ts.map
packages/shared-types/packages/
# Byte-identical duplicate of packages/database/drizzle/0000_regular_colossus.sql.
# `pnpm db:migrate` reads ./drizzle, so this copy is unused and misleading.
packages/database/migrations/
