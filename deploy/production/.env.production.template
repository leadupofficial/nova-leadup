# NOVA — Production environment template
# Deploy script copies this into .env.production and fills secrets at runtime.

# =========================================================
# Core
# =========================================================
NODE_ENV=production
DOMAIN=nova.leadup.in
APP_URL=https://nova.leadup.in

# =========================================================
# PostgreSQL / pgvector
# =========================================================
POSTGRES_USER=nova_app
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=nova
DATABASE_URL=postgres://nova_app:__CHANGE_ME__@postgres:5432/nova

# =========================================================
# Redis
# =========================================================
REDIS_PASSWORD=__CHANGE_ME__
REDIS_URL=redis://:__CHANGE_ME__@redis:6379

# =========================================================
# S3-compatible storage
# =========================================================
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=nova
S3_SECRET_KEY=__CHANGE_ME__
S3_BUCKET=nova-assets
S3_REGION=us-east-1

# =========================================================
# Auth (generate with: openssl rand -base64 64 / 32)
# =========================================================
JWT_SECRET=__CHANGE_ME__
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=__CHANGE_ME__
AUTH_ENCRYPTION_KEY=__CHANGE_ME__
API_KEY_SECRET=__CHANGE_ME__
CORS_ORIGIN=https://nova.leadup.in,https://admin.nova.leadup.in

# =========================================================
# AI / LLM providers
# =========================================================
ANTHROPIC_API_KEY=__CHANGE_ME__
# ANTHROPIC_BASE_URL=https://api.brocode.live/v1
# OPENAI_API_KEY=
# BROCODE_API_KEY=

# =========================================================
# Voice
# =========================================================
ELEVENLABS_API_KEY=__CHANGE_ME__
SARVAM_API_KEY=__CHANGE_ME__
DEEPGRAM_API_KEY=__CHANGE_ME__

# =========================================================
# Observability
# =========================================================
LOG_LEVEL=warn
# SENTRY_DSN=

# =========================================================
# Docker image tag (set by deploy script)
# =========================================================
IMAGE_TAG=prod
