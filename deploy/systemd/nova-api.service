# NOVA API — Systemd Service
# Deploy to: /etc/systemd/system/nova-api.service
# Usage: sudo systemctl enable --now nova-api

[Unit]
Description=NOVA AI Assistant API Server
Documentation=https://nova.leadup.in
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/nova/services/api
Environment=NODE_ENV=production
EnvironmentFile=/opt/nova/.env
ExecStartPre=/usr/bin/test -f /opt/nova/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nova-api

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nova

# Resource limits
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
