{
 "name": "@nova/prettier-config",
 "version": "0.1.0",
 "private": true,
 "description": "Shared Prettier configuration for NOVA monorepo",
 "main": "index.json",
 "semi": true,
 "trailingComma": "es5",
 "singleQuote": false,
 "printWidth": 100,
