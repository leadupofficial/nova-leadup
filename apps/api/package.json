{
 "name": "@nova/api",
 "version": "0.1.0",
 "private": true,
 "description": "NOVA backend API server",
 "scripts": {
 "dev": "tsx watch src/server-entry.ts",
 "start": "node dist/server.js",
 "build": "tsup src/server-entry.ts --format esm --out-dir dist",
 "test": "vitest run",
 "typecheck": "tsc --noEmit"
 },
 "dependencies": {
 "@nova/ai-core": "workspace:*",
 "@nova/shared-types": "workspace:*",
 "@nova/tools": "workspace:*",
 "express": "^4.21.0",
 "cors": "^2.8.5",
 "helmet": "^7.1.0",
 "morgan": "^1.10.0",
 "zod": "^3.24.0",
 "@anthropic-ai/sdk": "^0.122.0",
 "ws": "^8.16.0",
 "uuid": "^9.0.0",
 "dotenv": "^16.4.0"
 },
 "devDependencies": {
 "@types/express": "^4.17.0",
 "@types/cors": "^2.8.0",
 "@types/morgan": "^1.9.0",
 "@types/uuid": "^9.0.0",
 "@types/ws": "^8.5.0",
 "tsx": "^4.7.0",
 "tsup": "^8.0.0"
 }
}
