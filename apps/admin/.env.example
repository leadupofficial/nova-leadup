# =========================================================
# NOVA Admin — Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =========================================================

# --- Admin API ---
# Must include the /api/v1 prefix: the console's helpers append /admin/... and
# /auth/..., which the main API (services/api) serves under /api/v1.
# Next inlines NEXT_PUBLIC_* at build time, so this is a build argument in
# production — see the NEXT_PUBLIC_API_BASE ARG in apps/admin/Dockerfile.
NEXT_PUBLIC_API_BASE=https://nova.leadup.in/api/v1
ADMIN_API_KEY=<your-admin-api-key-here>

# --- Server-side rendering ---
# Optional. Without these, server components fall back to NEXT_PUBLIC_API_BASE
# and hairpin out through the public hostname instead of calling the api/admin
# containers directly on the compose network.
# API_INTERNAL_URL=http://api:3001/api/v1
# API_ORIGIN_URL=http://admin:3004

# --- Auth ---
# Optional: OAuth client IDs for admin SSO
# NEXT_PUBLIC_OAUTH_CLIENT_ID=<your-oauth-client-id>
