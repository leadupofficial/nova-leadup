# Release signing configuration for NOVA Android.
#
# Copy this file to `keystore.properties` and fill in real values.
# `keystore.properties` is git-ignored — never commit real secrets or keystores.
#
# You can override any value here with the ANDROID_* environment variables:
#   ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD,
#   ANDROID_KEY_ALIAS,      ANDROID_KEY_PASSWORD
# Environment variables take precedence over the values below.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore release.jks -alias <keyAlias> \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Required for release builds.

# Path to the keystore file. Can be absolute or relative to this android/ dir.
# Examples:
#   storeFile=release.jks
#   storeFile=/Users/you/keys/nova-release.jks
storeFile=

# Password for the keystore
storePassword=

# Alias name of the key inside the keystore
keyAlias=

# Password for the key (may equal storePassword)
keyPassword=
