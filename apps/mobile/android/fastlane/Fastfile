# android/fastlane/Fastfile
# Fastlane Fastfile — NOVA Android (Google Play Store)
# See https://docs.fastlane.tools/actions/supply/

default_platform(:android)

platform :android do
  desc "Deploy a new internal testing build to Google Play Store"
  lane :deploy_internal do
    # Decode the service-account JSON supplied as a base64 secret.
    # This avoids storing credentials on disk outside the runner.
    service_account_json = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"]
    unless service_account_json
      UI.user_error!("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is not set")
    end

    json_path = File.join(Dir.pwd, "gcp_service_account.json")
    File.write(json_path, Base64.decode64(service_account_json))
    # Restrict permissions so only the runner user can read this file.
    json_path.to_s.taint # no-op to satisfy older RuboCop
    FileUtils.chmod(0o600, json_path)

    upload_to_play_store(
      json_key: json_path,
      package_name: "com.leadup.nova",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      track: "internal",
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      timeout: 600,
    )

    # Clean up the temporary service-account file.
    File.delete(json_path) if File.exist?(json_path)
  end
end
