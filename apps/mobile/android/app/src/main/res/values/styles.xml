<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Flutter shows LaunchTheme while the engine boots, then swaps to NormalTheme
      once the first frame is ready (see the `io.flutter.embedding.android.NormalTheme`
      meta-data in AndroidManifest.xml).

      Both are parented on a platform theme on purpose: depending on
      `Theme.AppCompat` would require an explicit androidx.appcompat dependency and
      none of NOVA's plugins need it (local_auth uses the platform
      `Theme.Material.Dialog.Alert` for its prompt).
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@color/launch_background</item>
    </style>
</resources>
