<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Night-mode variants. These MUST exist and must be identical in name to the
      values/ versions: when LaunchTheme/NormalTheme were defined only here,
      aapt2 failed to resolve `@style/LaunchTheme` for the default configuration.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@color/launch_background</item>
    </style>
</resources>
