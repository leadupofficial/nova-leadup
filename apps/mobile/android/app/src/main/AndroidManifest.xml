<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.USE_BIOMETRICS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Device & system control (§9.2).

      Exactly two permissions are added, and both are ones Android can actually
      grant to a third-party app — each through a dedicated Settings screen the
      user must approve, which is why they are *special* accesses rather than
      runtime prompts:

        * WRITE_SETTINGS       — screen brightness. Granted on
                                 Settings → Apps → NOVA → Modify system settings
                                 (Settings.ACTION_MANAGE_WRITE_SETTINGS).
        * ACCESS_NOTIFICATION_POLICY — Do Not Disturb. Granted on
                                 Settings → Notifications → Do Not Disturb access
                                 (Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS).

      Deliberately NOT added, because a third-party app cannot be granted them or
      because the capability is out of scope:

        * CALL_PHONE / ANSWER_PHONE_CALLS — §9.2 says "Show number, confirm", so
          dialling is ACTION_DIAL only; NOVA never places a call itself.
        * BLUETOOTH_CONNECT / BLUETOOTH_SCAN — Bluetooth enable()/disable() became
          no-ops for third-party apps on Android 12; no permission restores it, so
          NOVA only deep-links to the Bluetooth screen.
        * CHANGE_WIFI_STATE / ACCESS_WIFI_STATE — setWifiEnabled stopped working for
          third-party apps on Android 10; NOVA only deep-links to the Wi-Fi screen.
        * QUERY_ALL_PACKAGES — a restricted Play permission. App launching uses a
          <queries> launcher intent instead.
        * PACKAGE_USAGE_STATS, MEDIA_CONTENT_CONTROL, any Accessibility permission —
          not needed, and screen reading is excluded from the consumer MVP.
        * WRITE_SECURE_SETTINGS — signature-level; an app can never be granted it.
        * SEND_SMS — §9.2 defers SMS explicitly.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!--
          Android 11+ package visibility: without this the on-device TTS engine
          (flutter_tts) cannot be discovered and the fallback voice would be
          reported as unavailable on a device that actually has one.
        -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!--
          Device & system control (§9.2): lets NOVA resolve the launcher entry
          point of an installed app in order to open it. This is the narrow,
          policy-safe alternative to QUERY_ALL_PACKAGES — it makes launcher apps
          visible and nothing else.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Deep links opened with ACTION_VIEW. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- ACTION_DIAL: the dialer that shows the confirmed number. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <!--
      The `package` attribute is intentionally omitted: the namespace is declared
      once in app/build.gradle.kts (`namespace = "com.leadup.nova"`). Declaring it
      in both places is an error on Android Gradle Plugin 8+.
    -->
    <application
        android:label="NOVA"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          REQUIRED. Tells the Flutter tool that this app uses the Android v2
          embedding. Without it `flutter build apk` aborts with
          "Build failed due to use of deleted Android v1 embedding."
        -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Firebase Cloud Messaging notification icon. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- Crashlytics: automatic collection. Effective only once a real
             google-services.json is generated (flutterfire configure); the
             committed one is still a placeholder. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="true" />

        <!-- Main Flutter activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Wake-word foreground service. This is the ONLY wake-word service in the
          app: `.WakeWordForegroundService`, `.NovaWakeService` and their
          duplicates were removed.
        -->
        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Boot receiver: restarts the wake-word service after a reboot. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <!--
              Only BOOT_COMPLETED: LOCKED_BOOT_COMPLETED would additionally require
              android:directBootAware="true", and the wake word needs the user's
              unlocked credential storage to know whether they opted in.
            -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!--
          Smart Notification Assistant (§5.21) — the ONLY notification listener in
          the app. It replaced `NotificationListener`, a BroadcastReceiver for the
          custom action `nova.notification.POSTED` that nothing ever sent; a
          receiver cannot read system notifications, which is why the feature did
          not exist.

          `android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"`
          is the platform's own guard: BIND_NOTIFICATION_LISTENER_SERVICE is a
          signature-level permission held only by the system, so although the
          service is exported (which the system needs in order to bind it) no
          third-party app can. It is deliberately NOT declared as a
          <uses-permission> — an app can never be granted it, and requesting it
          would only imply a capability NOVA does not hold. This is the same
          declaration AOSP's own CTS notification-listener app uses.

          No other permission is added for this feature: reading notifications
          comes from the user selecting NOVA in Android Settings → Notifications →
          Device & app notifications → Notification access, which is a grant no
          manifest entry can request. The service reads the in-app master toggle
          from its own SharedPreferences and does nothing at all while it is off,
          so the grant alone is never treated as consent.
        -->
        <service
            android:name=".NovaNotificationListenerService"
            android:label="NOVA Notification Assistant"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          flutter_local_notifications receivers. The plugin only ships the
          POST_NOTIFICATIONS and VIBRATE permissions itself, so an app that
          schedules notifications must declare these two or the alarm fires into
          nothing:
            * ScheduledNotificationReceiver delivers the alarm when it is due;
            * ScheduledNotificationBootReceiver re-registers pending alarms after
              a reboot or an app update, which is what lets a reminder survive the
              phone restarting.
          No new permissions: RECEIVE_BOOT_COMPLETED and SCHEDULE_EXACT_ALARM are
          already declared above.
        -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
