<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Removed 2026-09-20, before the first Play submission: CAMERA,
      READ_EXTERNAL_STORAGE, READ_MEDIA_IMAGES, READ_MEDIA_VIDEO and
      USE_BIOMETRICS were declared and used by nothing.

      Verified by grep over lib/ and android/app/src/main/java/ for the
      corresponding APIs (`Permission.camera`, `Permission.photos`,
      `Permission.storage`, `image_picker`/`ImagePicker`, `local_auth`,
      `biometric`): zero references, and neither `image_picker` nor `local_auth` is
      a dependency in pubspec.yaml. The app takes no photos, reads no user media
      (the call-recording import uses the Storage Access Framework, which needs no
      permission at all), and has no biometric unlock.

      Play flags apps that request sensitive permissions they do not use, and the
      Data Safety form has to match what the app actually collects — so a
      camera/photos/biometrics declaration would have to be justified in review and
      contradicted in the form. Unused permissions are also a real over-privilege
      risk on the device, not just a paperwork one.
    -->

    <!--
      Firebase Analytics arrives with `ACCESS_ADSERVICES_AD_ID` and
      `ACCESS_ADSERVICES_ATTRIBUTION` merged in from play-services-measurement-api.
      NOVA shows no ads and does no attribution, so both are removed rather than
      declared:

        * on Play, holding an advertising-ID permission makes the Data Safety form
          disclose "Device or other IDs" collected for advertising purposes, which
          would be untrue here; and
        * the same access is precisely what iOS App Tracking Transparency exists to
          gate, so leaving it in invites the ATT question on a product that does not
          track.

      Analytics keeps working: it identifies an install by its app-instance ID, not by
      the advertising ID. Verified in the merged **release** manifest after this change.
    -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <!--
      `ACCESS_ADSERVICES_*` were not the whole story. play-services-measurement also
      merges in the *runtime* advertising-ID permission and the install-referrer
      binding, which the block above does not touch:

        * `com.google.android.gms.permission.AD_ID` — the permission Play actually
          keys the Data safety "Device or other IDs / Advertising" disclosure off.
          If it is present in the built manifest, the truthful answer on the form
          becomes "collected", and Play checks the manifest against the form. It was
          still present after the first removal pass.
        * `com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE` —
          attribution/install-referrer binding. Same reasoning: NOVA attributes
          nothing.

      Both are removed at merge time with `tools:node="remove"`. Verified in the
      merged **release** manifest after this change; Firebase Analytics continues to
      work off the app-instance ID.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE" tools:node="remove" />

    <!--
      Device & system control (§9.2).

      Exactly two permissions are added, and both are ones Android can actually
      grant to a third-party app — each through a dedicated Settings screen the
      user must approve, which is why they are *special* accesses rather than
      runtime prompts:

        * WRITE_SETTINGS       — screen brightness. Granted on
                                 Settings → Apps → NOVA → Modify system settings
                                 (Settings.ACTION_MANAGE_WRITE_SETTINGS).
        * ACCESS_NOTIFICATION_POLICY — Do Not Disturb. Granted on
                                 Settings → Notifications → Do Not Disturb access
                                 (Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS).

      Deliberately NOT added, because a third-party app cannot be granted them or
      because the capability is out of scope:

        * CALL_PHONE / ANSWER_PHONE_CALLS — §9.2 says "Show number, confirm", so
          dialling is ACTION_DIAL only; NOVA never places a call itself.
        * BLUETOOTH_CONNECT / BLUETOOTH_SCAN — Bluetooth enable()/disable() became
          no-ops for third-party apps on Android 12; no permission restores it, so
          NOVA only deep-links to the Bluetooth screen.
        * CHANGE_WIFI_STATE / ACCESS_WIFI_STATE — setWifiEnabled stopped working for
          third-party apps on Android 10; NOVA only deep-links to the Wi-Fi screen.
        * QUERY_ALL_PACKAGES — a restricted Play permission. App launching uses a
          <queries> launcher intent instead.
        * PACKAGE_USAGE_STATS, MEDIA_CONTENT_CONTROL, any Accessibility permission —
          not needed, and screen reading is excluded from the consumer MVP.
        * WRITE_SECURE_SETTINGS — signature-level; an app can never be granted it.
        * SEND_SMS — §9.2 defers SMS explicitly.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!--
          Android 11+ package visibility: without this the on-device TTS engine
          (flutter_tts) cannot be discovered and the fallback voice would be
          reported as unavailable on a device that actually has one.
        -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!--
          Device & system control (§9.2): lets NOVA resolve the launcher entry
          point of an installed app in order to open it. This is the narrow,
          policy-safe alternative to QUERY_ALL_PACKAGES — it makes launcher apps
          visible and nothing else.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Deep links opened with ACTION_VIEW. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- ACTION_DIAL: the dialer that shows the confirmed number. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <!--
      The `package` attribute is intentionally omitted: the namespace is declared
      once in app/build.gradle.kts (`namespace = "com.leadup.nova"`). Declaring it
      in both places is an error on Android Gradle Plugin 8+.
    -->
    <application
        android:label="NOVA"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false">

        <!--
          `roundIcon` was missing, so a launcher that asks for a round icon (rather
          than mask-intersecting the square one) fell back to `ic_launcher`. Both now
          resolve: `mipmap-anydpi-v26/ic_launcher_round.xml` is an adaptive icon on
          API 26+, and the density PNGs cover API 24-25.
        -->

        <!--
          `allowBackup` is off, which is a deliberate privacy decision rather than a
          default. With it unset (the previous state) Android backs app data up to the
          user's Google Drive automatically, and for NOVA that means local caches of
          voice transcripts, meeting recordings and saved memories leaving the device
          without the user ever being asked. The account on the server is the source of
          truth — everything durable is already synced — so nothing is lost by refusing
          the automatic cloud copy, and the onboarding preferences are the only
          device-local state worth re-entering.

          `fullBackupContent="false"` disables the key/value and full backup paths for
          API <= 30 as well; API 31+ honours `allowBackup` alone.
        -->

        <!--
          REQUIRED. Tells the Flutter tool that this app uses the Android v2
          embedding. Without it `flutter build apk` aborts with
          "Build failed due to use of deleted Android v1 embedding."
        -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Firebase Cloud Messaging notification icon. `firebase_messaging` is not a
             dependency and nothing registers for push, so this meta-data is inert; it
             is kept because removing it would silently change the icon for any future
             FCM integration. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- Crashlytics: automatic collection. This is **live**: the committed
             `google-services.json` is real (project `nova-leadup-stagging`, zero
             `YOUR_` placeholders), so crash reports are collected in release builds.
             The Data safety form must therefore declare "App info and performance →
             Crash logs, Diagnostics" for Android. (iOS is separate and still inert —
             its `GoogleService-Info.plist` is a placeholder that is not even bundled.) -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="true" />

        <!-- Main Flutter activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Wake-word foreground service. This is the ONLY wake-word service in the
          app: `.WakeWordForegroundService`, `.NovaWakeService` and their
          duplicates were removed.
        -->
        <!--
          `stopWithTask="false"` is the difference between "listening" and "listening until
          you swipe the app away".

          Android's default is `true`, so removing NOVA from Recents killed the service and
          the wake word stopped — with no indication to the user that it had, and no way to
          tell short of watching the log. The service is a foreground service with a
          persistent notification, which is exactly the contract that says it may outlive
          its task: the user can see it running and stop it deliberately.

          Measured on a OnePlus 9R, this is necessary but not sufficient: OxygenOS ALSO
          freezes the whole process when the screen goes off
          (`OplusHansManager: freeze uid … scene: LcdOff`), which stops detection
          regardless of this flag. Beating that needs the user to exclude NOVA from
          battery optimisation — see the note in docs/REQUIREMENTS_VERIFICATION.md about
          why that is offered as a settings link rather than the restricted
          REQUEST_IGNORE_BATTERY_OPTIMIZATIONS permission.
        -->
        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone" />

        <!-- Boot receiver: restarts the wake-word service after a reboot. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <!--
              Only BOOT_COMPLETED: LOCKED_BOOT_COMPLETED would additionally require
              android:directBootAware="true", and the wake word needs the user's
              unlocked credential storage to know whether they opted in.
            -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!--
          Smart Notification Assistant (§5.21) — the ONLY notification listener in
          the app. It replaced `NotificationListener`, a BroadcastReceiver for the
          custom action `nova.notification.POSTED` that nothing ever sent; a
          receiver cannot read system notifications, which is why the feature did
          not exist.

          `android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"`
          is the platform's own guard: BIND_NOTIFICATION_LISTENER_SERVICE is a
          signature-level permission held only by the system, so although the
          service is exported (which the system needs in order to bind it) no
          third-party app can. It is deliberately NOT declared as a
          <uses-permission> — an app can never be granted it, and requesting it
          would only imply a capability NOVA does not hold. This is the same
          declaration AOSP's own CTS notification-listener app uses.

          No other permission is added for this feature: reading notifications
          comes from the user selecting NOVA in Android Settings → Notifications →
          Device & app notifications → Notification access, which is a grant no
          manifest entry can request. The service reads the in-app master toggle
          from its own SharedPreferences and does nothing at all while it is off,
          so the grant alone is never treated as consent.
        -->
        <service
            android:name=".NovaNotificationListenerService"
            android:label="NOVA Notification Assistant"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          flutter_local_notifications receivers. The plugin only ships the
          POST_NOTIFICATIONS and VIBRATE permissions itself, so an app that
          schedules notifications must declare these two or the alarm fires into
          nothing:
            * ScheduledNotificationReceiver delivers the alarm when it is due;
            * ScheduledNotificationBootReceiver re-registers pending alarms after
              a reboot or an app update, which is what lets a reminder survive the
              phone restarting.
          No new permissions: RECEIVE_BOOT_COMPLETED and SCHEDULE_EXACT_ALARM are
          already declared above.
        -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
