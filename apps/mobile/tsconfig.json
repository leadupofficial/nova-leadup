{
 "extends": "../../tsconfig.base.json",
 "compilerOptions": {
 "outDir": "dist",
 "baseUrl": ".",
 "paths": {
 "nova-ui": ["./node_modules/nova-ui/index.js"],
 "nova-api": ["./node_modules/nova-api/index.js"],
 "nova-avatar": ["./node_modules/nova-avatar/index.js"],
