 }
 },
 "include": ["expo-router/**/*.ts", "expo-router/**/*.tsx", "src/**/*", "node_modules/nova-ui/**/*", "node_modules/nova-api/**/*", "node_modules/nova-avatar/**/*", "node_modules/nova-voice/**/*"],
 "exclude": ["node_modules", "dist"]
}
