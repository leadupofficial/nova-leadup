#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing — never commit secrets or keystores.
# `android/.gitignore` already covers apps/mobile/android/keystore.properties, but a
# stray copy at apps/mobile/keystore.properties was NOT ignored and held a real
# keystore password, one `git add .` away from being committed.
keystore.properties
**/keystore.properties
*.jks
*.keystore

# Local environment overrides (the committed .env.production.example documents the
# required variables; real values must never be committed).
.env
.env.local
.env.*.local
