# Android release signing — copy to `keystore.properties` and fill real values.
# This file is git-ignored (see android/.gitignore). NEVER commit it.
#
# Path to the keystore file (absolute or relative to this file's directory).
storeFile=/path/to/nova-release.jks

# Keystore password (the password for the .jks file itself).
storePassword=CHANGEME

# Key alias — the name you gave the key when generating it.
keyAlias=nova

# Key password (the password for the specific alias, may equal storePassword).
keyPassword=CHANGEME
