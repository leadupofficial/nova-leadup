{
 "compilerOptions": {
 "target": "ES2020",
 "module": "Node16",
 "moduleResolution": "node16",
 "lib": ["ES2020"],
 "outDir": "dist",
 "rootDir": "src",
 "declaration": true,
 "declarationMap": true,
 "sourceMap": false,
 "strict": true,
 "esModuleInterop": true,
 "skipLibCheck": true,
 "forceConsistentCasingInFileNames": true,
 "resolveJsonModule": true,
 "noEmit": false,
 "allowImportingTsExtensions": false
 },
 "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/__tests__/**"]
}
