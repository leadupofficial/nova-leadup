{
 "name": "@nova/workers",
 "version": "0.1.0",
 "private": true,
 "description": "NOVA background job workers",
 "main": "./dist/index.js",
 "type": "module",
 "scripts": {
 "dev": "tsx watch src/index.ts",
 "build": "tsc",
 "start": "node dist/index.js",
 "lint": "eslint src/",
 "type-check": "tsc --noEmit",
 "test": "vitest run",
 "test:watch": "vitest",
 "clean": "rm -rf dist",
 "audit": "pnpm audit --audit-level=moderate"
 },
 "dependencies": {
 "@nova/types": "workspace:*",
 "@nova/utils": "workspace:*",
 "bullmq": "^5.52.2",
 "ioredis": "^5.6.1",
 "pino": "^9.7.0",
 "pg": "^8.16.0"
 },
 "devDependencies": {
 "@nova/config": "workspace:*",
 "typescript": "^5.8.3",
 "eslint": "^9.27.0",
 "@types/pg": "^8.11.15",
 "tsx": "^4.7.0",
 "vitest": "^3.2.0"
 }
}
