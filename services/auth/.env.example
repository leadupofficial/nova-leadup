# =========================================================
# @nova/auth — Auth Service
# =========================================================

# --- Server ---
PORT=3003
NODE_ENV=production

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:CHANGE_BEFORE_DEPLOY@localhost:5432/nova

# --- JWT Signing (RS256 — default, production) ---
# Keys live under services/auth/keys/ (git-ignored).
JWT_ALG=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_KEY_ID=nova-default
JWT_SECRET=CHANGE_BEFORE_DEPLOY_MIN_32_CHARS_USE_OPENSSL_RANDOM
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_BEFORE_DEPLOY_MIN_32_CHARS
JWT_ACCESS_TTL=15m

# --- Encryption ---
AUTH_ENCRYPTION_KEY=CHANGE_BEFORE_DEPLOY_32_BYTE_BASE64

# --- Rate limit ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Logging ---
LOG_LEVEL=info

# ---------------------------------------------------------
# ⚠️ CHANGE BEFORE DEPLOY: Replace every "CHANGE_BEFORE_DEPLOY*"
# placeholder above with real values. Generate RS256 keys via:
# openssl genrsa -out services/auth/keys/private.pem 2048
# openssl rsa -in services/auth/keys/private.pem -pubout -out services/auth/keys/public.pem
# ---------------------------------------------------------
