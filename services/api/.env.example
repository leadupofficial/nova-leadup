# NOVA API Server - Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Server
PORT=3001
NODE_ENV=production

# Database
# Must match packages/database/scripts/start-pgvector.sh, which creates the
# `nova-pgvector` container on port 5433 with user nova_user. (This example used to
# say nova@localhost:5432, a database that does not exist — every query then failed
# with 'password authentication failed for user "nova"'.)
DATABASE_URL=postgres://nova_user:nova_secure_2026@127.0.0.1:5433/nova

# AI / LLM
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which model serves which surface. Unset, all three fall back to each other and
# to the built-in default, so a deployment that sets nothing behaves as before.
#   ANTHROPIC_MODEL           typed turns, briefing, meeting summaries — where
#                             reasoning quality is worth waiting for.
#   ANTHROPIC_REALTIME_MODEL  the streaming voice socket, where TTFT is the
#                             whole experience.
#   ANTHROPIC_VOICE_MODEL     the one-shot POST /api/v1/voice/chat turn. Defaults
#                             to ANTHROPIC_REALTIME_MODEL.
# Keep the two spoken ids on a *fast* model. Measured on the live voice route
# over six spoken prompts: GLM-5.3 answered in 15-131 s (mean 61 s) and returned
# HTTP 502 on one advice question after 112 s, because its reasoning consumed the
# entire output budget and left no text; claude-haiku-4-5 answered the same six
# in 3.7 s mean. A minute per spoken turn is not a conversation.
#ANTHROPIC_MODEL=glm-5.3
#ANTHROPIC_REALTIME_MODEL=claude-haiku-4-5
#ANTHROPIC_VOICE_MODEL=claude-haiku-4-5

# Secondary LLM provider (all optional). Left unset there is no fallback, and a
# primary-provider outage fails the turn. Set BASE_URL and API_KEY to enable it:
# when the primary is unusable — out of credit, 5xx, timed out or unreachable —
# the same request is retried here. It is NOT used for a request error (400),
# for an auth failure from this service's own middleware, or once the turn has
# already executed a tool or spoken a token, so a fallback can never duplicate a
# reminder or make the user hear half a sentence twice.
# The likely providers (apimaster.ai, Z.ai/GLM, Moonshot/Kimi, DeepSeek) are
# OpenAI-compatible, which is the default protocol.
#LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
#LLM_FALLBACK_API_KEY=your-fallback-key-here
# Model id to ask the fallback for. Unset = ANTHROPIC_MODEL.
#LLM_FALLBACK_MODEL=deepseek-chat
# bearer (Authorization: Bearer) | api-key (x-api-key). Unset = bearer for the
# openai protocol, api-key for the anthropic one.
#LLM_FALLBACK_AUTH_STYLE=bearer
# openai (POST {base}/chat/completions) | anthropic (POST {base}/v1/messages).
# Unset = inferred from LLM_FALLBACK_AUTH_STYLE: api-key implies anthropic,
# anything else implies openai.
#LLM_FALLBACK_PROTOCOL=openai

# Maximum output tokens per chat completion, reasoning tokens INCLUDED. Default
# 4096. A reasoning model (GLM, DeepSeek-R1, Kimi, ...) bills its
# `reasoning_content` against this same budget, so a value that is fine for a
# plain model produces empty replies from a reasoning one: at 1024 the model
# spent 1023 tokens thinking, was cut off with `finish_reason: length`, and
# returned no answer at all. Too high is a runaway-cost ceiling. 256-32768.
#LLM_MAX_OUTPUT_TOKENS=4096

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here
# Access-token lifetime. JWT_EXPIRY and JWT_ACCESS_TTL are also accepted.
JWT_EXPIRES_IN=15m
# Refresh-token lifetime. JWT_REFRESH_TTL is also accepted.
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=https://nova.leadup.in,https://admin.nova.leadup.in

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# ── Realtime voice cost instrumentation (optional, USD) ─────────────
# Contracted unit rates used ONLY to compute the per-turn
# "Realtime voice turn cost" log line. Nothing is cached or stored.
# Leave a rate unset and that leg is logged with its billed quantity but
# cost "unknown" (null) rather than 0. Per-provider keys override the
# generic key for the same leg.
# The values below are OBVIOUS PLACEHOLDERS, not prices — replace them
# with your contracted rates.
#VOICE_COST_STT_PER_MINUTE=0.01
#VOICE_COST_STT_SARVAM_PER_MINUTE=0.01
#VOICE_COST_STT_DEEPGRAM_PER_MINUTE=0.01
#VOICE_COST_LLM_INPUT_PER_MTOK=1
#VOICE_COST_LLM_OUTPUT_PER_MTOK=1
#VOICE_COST_TTS_PER_1K_CHARS=0.01
#VOICE_COST_TTS_SARVAM_PER_1K_CHARS=0.01
#VOICE_COST_TTS_ELEVENLABS_PER_1K_CHARS=0.01
#VOICE_COST_TTS_DEEPGRAM_PER_1K_CHARS=0.01

# Timezone for the API process. Must be UTC.
#
# Every timestamp column in this schema is `timestamp` without time zone, and the two drivers in
# use (Drizzle and node-postgres) disagree about how to serialise a Date into one unless the
# process is UTC: Drizzle writes UTC, node-postgres writes local time and reads it back as local
# time. With a non-UTC process, a value written by one and read by the other is off by the host
# offset. The database itself runs Etc/UTC.
TZ=UTC
