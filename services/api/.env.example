# NOVA API Server - Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Server
PORT=3001
NODE_ENV=production

# Database
# Must match packages/database/scripts/start-pgvector.sh, which creates the
# `nova-pgvector` container on port 5433 with user nova_user. (This example used to
# say nova@localhost:5432, a database that does not exist — every query then failed
# with 'password authentication failed for user "nova"'.)
DATABASE_URL=postgres://nova_user:nova_secure_2026@127.0.0.1:5433/nova

# AI / LLM
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here
# Access-token lifetime. JWT_EXPIRY and JWT_ACCESS_TTL are also accepted.
JWT_EXPIRES_IN=15m
# Refresh-token lifetime. JWT_REFRESH_TTL is also accepted.
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=https://nova.leadup.in,https://admin.nova.leadup.in

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# ── Realtime voice cost instrumentation (optional, USD) ─────────────
# Contracted unit rates used ONLY to compute the per-turn
# "Realtime voice turn cost" log line. Nothing is cached or stored.
# Leave a rate unset and that leg is logged with its billed quantity but
# cost "unknown" (null) rather than 0. Per-provider keys override the
# generic key for the same leg.
# The values below are OBVIOUS PLACEHOLDERS, not prices — replace them
# with your contracted rates.
#VOICE_COST_STT_PER_MINUTE=0.01
#VOICE_COST_STT_SARVAM_PER_MINUTE=0.01
#VOICE_COST_STT_DEEPGRAM_PER_MINUTE=0.01
#VOICE_COST_LLM_INPUT_PER_MTOK=1
#VOICE_COST_LLM_OUTPUT_PER_MTOK=1
#VOICE_COST_TTS_PER_1K_CHARS=0.01
#VOICE_COST_TTS_SARVAM_PER_1K_CHARS=0.01
#VOICE_COST_TTS_ELEVENLABS_PER_1K_CHARS=0.01
#VOICE_COST_TTS_DEEPGRAM_PER_1K_CHARS=0.01
