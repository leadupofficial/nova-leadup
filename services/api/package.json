{
 "name": "@nova/api",
 "version": "0.1.0",
 "private": true,
 "description": "NOVA REST/GraphQL API service",
 "main": "./dist/index.js",
 "type": "module",
 "scripts": {
 "dev": "tsx watch src/index.ts",
 "build": "tsc",
 "start": "node dist/index.js",
 "lint": "eslint src/",
 "type-check": "tsc --noEmit",
 "test": "vitest run",
 "test:watch": "vitest",
 "test:coverage": "vitest run --coverage",
 "db:migrate": "dotenv -e .env.local -- node -e 'require(\"./src/db/migrate\").migrate()'",
 "db:seed": "dotenv -e .env.local -- node -e 'require(\"./src/db/seed\").seed()'",
 "audit": "pnpm audit --audit-level=moderate",
 "clean": "rm -rf dist"
 },
 "dependencies": {
 "@nova/types": "workspace:*",
 "@nova/utils": "workspace:*",
 "zod": "^3.25.76",
 "pino": "^9.7.0",
 "ioredis": "^5.6.1",
 "pg": "^8.16.0"
 },
 "devDependencies": {
 "@nova/config": "workspace:*",
 "typescript": "^5.8.3",
 "eslint": "^9.27.0",
 "@types/pg": "^8.11.15",
 "tsx": "^4.7.0",
 "vitest": "^3.2.0"
 }
}
