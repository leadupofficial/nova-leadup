{
 "name": "@nova/api",
 "version": "0.1.0",
 "private": true,
 "description": "NOVA Leadup — Main REST API service",
 "type": "module",
 "main": "./dist/server.js",
 "scripts": {
 "dev": "tsx watch src/server.ts",
 "build": "tsc && tsc-alias -p tsconfig.json",
 "start": "node dist/server.js",
 "lint": "eslint src/",
 "type-check": "tsc --noEmit",
 "test": "vitest run",
 "test:watch": "vitest",
 "test:coverage": "vitest run --coverage",
 "clean": "rm -rf dist"
 },
 "dependencies": {
 "@anthropic-ai/sdk": "^0.50.0",
 "@nova/ai-core": "workspace:*",
 "@nova/auth": "workspace:*",
 "@nova/database": "workspace:*",
 "@nova/observability": "workspace:*",
 "@nova/shared-types": "workspace:*",
 "@nova/voice": "workspace:*",
 "bcryptjs": "^2.4.3",
 "cors": "^2.8.5",
 "dotenv": "^16.4.0",
 "drizzle-orm": "^0.39.0",
 "express": "^4.21.0",
 "helmet": "^8.0.0",
 "jsonwebtoken": "^9.0.2",
 "pg": "^8.23.0",
 "pino": "^9.5.0",
 "pino-pretty": "^13.0.0",
 "socket.io": "^4.8.3",
 "zod": "^3.25.76"
 },
 "devDependencies": {
 "@types/bcryptjs": "^2.4.6",
 "@types/cors": "^2.8.0",
 "@types/express": "^4.17.21",
 "@types/helmet": "^4.0.0",
 "@types/jsonwebtoken": "9.0.7",
 "@types/pg": "^8.23.1",
 "@types/pino": "^7.0.0",
 "@types/socket.io": "^3.0.2",
 "@types/supertest": "^6.0.2",
 "eslint": "^9.17.0",
 "supertest": "^7.0.0",
 "tsc-alias": "^1.8.0",
 "tsx": "^4.19.0",
 "typescript": "^5.7.0",
 "uuid": "^9.0.1",
 "vitest": "^2.1.0"
 },
 "exports": {
 ".": {
 "types": "./dist/server.d.ts",
 "import": "./dist/server.js"
 }
 }
}
