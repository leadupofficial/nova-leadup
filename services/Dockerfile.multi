# Stage 1: Install ALL workspace dependencies (prod only)
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat python3 make g++ py3-setuptools
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
ENV PYTHON=/usr/bin/python3
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml turbo.json package.json ./
COPY packages ./packages
COPY services ./services
RUN pnpm install --no-frozen-lockfile --prod

# Stage 2: Per-service final images
FROM node:22-alpine AS api-final
WORKDIR /app
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/services ./services
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/services/api/dist ./dist
WORKDIR /app/services/api
RUN addgroup --system app && adduser --system app
USER app
EXPOSE 3001
CMD ["node", "dist/server.js"]

