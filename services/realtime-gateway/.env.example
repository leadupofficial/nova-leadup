# NOVA Realtime Gateway Environment Configuration

PORT=3002
NODE_ENV=development

# Auth (JWT secret must match @nova/auth)
JWT_SECRET=change-me-in-development-please-use-32-plus-chars

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:3005

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=info

# STT provider
DEEPGRAM_API_KEY=
